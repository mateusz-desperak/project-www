RewriteEngine On
Options -Indexes
AddDefaultCharset UTF-8

RewriteRule ^nasza-kawiarnia$ index.html [L]
RewriteRule ^poznaj-nas$ about.html [L]
RewriteRule ^zobacz-oferte$ menu.html [L]
RewriteRule ^zobacz-galerie$ gallery.html [L]
RewriteRule ^zarezerwuj-stolik$ reservation.html [L]
RewriteRule ^napisz-do-nas$ contact.html [L]
RewriteRule ^zobacz-nowosci$ news.html [L]